# .env.example — Local environment configuration for the modme-raintree workspace
#
# Copy this file to .env and fill in the values for your local setup.
# Never commit .env — it is listed in .gitignore.
#
# Values in agent.json mcps[].env reference these variables as ${VAR_NAME}.
# The agent-starter sync CLI resolves them at sync time and writes the
# resolved values into each agent's native config (e.g. .claude/settings.json).
# If a variable is absent at sync time, agent-starter logs a warning and
# re-documents it here.
#
# TOON note: token-heavy runtime dumps (logs, traces) should be piped through
# `agent-starter toon-encode` before being embedded in agent context to stay
# within the session token budget.  See templates/.claude/skills/toon-formatter.

# ── Python executor MCP (py-executor) ────────────────────────────────────────
# Absolute path to the Python interpreter inside the active WSL / Nix shell.
# Example (WSL): /home/<user>/.nix-profile/bin/python3
# Example (venv): /workspace/.venv/bin/python3
PYTHON_BIN=

# Colon-separated list of paths prepended to PYTHONPATH when the MCP server
# starts.  Add src directories for local agent packages here.
LOCAL_PYTHON_PATH=

# Wall-clock milliseconds a single MCP tool call may run before the
# orchestrator treats it as a timeout.  Defaults to 30000 (30 s) if unset.
MCP_RUNTIME_TIMEOUT=30000

# ── File-system watchdog MCP (fs-watchdog) ────────────────────────────────────
# Absolute path to the Node.js binary used to launch the watchdog server.
# Defaults to whichever `node` is on PATH if left empty.
NODE_BIN=

# Absolute path to the watchdog MCP entry script.
# Example: /workspace/scripts/fs-watchdog-server.mjs
FS_WATCHDOG_SCRIPT=

# Root directory tree that the watchdog monitors.  Restrict to your workspace
# root to avoid scanning the entire filesystem.
WATCHDOG_ROOT=

# Comma-separated glob patterns the watchdog skips.
# Sensible defaults: node_modules,dist,.git,__pycache__
WATCHDOG_IGNORE_PATTERNS=node_modules,dist,.git,__pycache__

# ── Agent model overrides ────────────────────────────────────────────────────
# Model id used when agent.json model.claude is not set explicitly.
# Uncomment and set to pin a specific Claude model for local testing.
# CLAUDE_MODEL=claude-sonnet-4-5

# ── WSL / Nix-shell helpers ──────────────────────────────────────────────────
# Set to 1 to enable verbose orchestrator logging (structured JSON on stdout).
# ORCHESTRATOR_JSON_LOG=0

# Absolute path to the Nix profile bin directory, if using nix-shell.
# Useful when the Nix profile is not on PATH inside WSL.
# NIX_PROFILE_BIN=/home/<user>/.nix-profile/bin
